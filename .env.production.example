# app_plan.md §14.1 — variáveis de PRODUÇÃO.
# Copie para `.env.production` e preencha. Nunca commite `.env.production`.
# `chmod 600 .env.production` no host; dono `root` ou o usuário do deploy.

APP_ENV=production

# --- Postgres ---
POSTGRES_DB=registers
POSTGRES_USER=registers_app
POSTGRES_PASSWORD=change-me-strong

# DATABASE_URL usada pela API (hostname `postgres` = service do compose).
DATABASE_URL=postgresql+asyncpg://registers_app:change-me-strong@postgres:5432/registers

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
# Opcional; se descomentar Haiku, teste antes que sua conta tem acesso:
# ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5-20251001

# --- Auth ---
# JWT: gere com `openssl rand -base64 48`. Const. §16.
JWT_SECRET=change-me-generate-with-openssl-rand
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=1209600
COOKIE_DOMAIN=app.example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Admin bootstrap (SP-05 / Const. §24) ---
# CLI consome no primeiro `python -m app.cli bootstrap` e depois **NUNCA
# mais é referenciada em runtime**. Ainda assim, deixe uma senha forte
# aqui e considere trocar via `python -m app.cli reset-password` depois.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-strong

# --- Storage (MinIO local ou S3-compat externo) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=registers-media
S3_ACCESS_KEY=change-me-minio-key
S3_SECRET_KEY=change-me-minio-secret
S3_FORCE_PATH_STYLE=true
# PRECISA ficar setado quando MinIO fica na rede interna do compose (setup
# default). O host interno `minio:9000` não é resolvível pelo browser +
# viola CSP `img-src 'self'`. Reescrevemos a URL assinada pra
# `https://${DOMAIN}/media` e o Nginx faz proxy pra minio:9000
# (ver `infra/nginx/conf.d/app.conf` location /media/).
# Substitua ${DOMAIN} pelo seu domínio real:
S3_PUBLIC_BASE_URL=https://app.example.com/media

# --- MinIO server (credenciais do serviço, não do cliente) ---
# Em produção, use as MESMAS credenciais no par S3_* acima (não criamos
# user secundário). Divergência entre S3_ACCESS_KEY e MINIO_ROOT_USER
# provoca InvalidAccessKeyId no upload.
MINIO_ROOT_USER=change-me-minio-key
MINIO_ROOT_PASSWORD=change-me-minio-secret

# --- Domain / TLS ---
DOMAIN=app.example.com
LETSENCRYPT_EMAIL=felix@example.com

# --- Timezone ---
TZ=America/Sao_Paulo

# --- CORS / segurança ---
ALLOWED_ORIGINS=https://app.example.com
RATE_LIMIT_LOGIN_PER_MIN=5

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
