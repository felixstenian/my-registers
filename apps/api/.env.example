# Copie para apps/api/.env quando for rodar o backend no host (Caminho A).
# Estes valores assumem Postgres e MinIO subidos via `pnpm infra:up`,
# expondo as portas 5432 e 9000 no localhost.

APP_ENV=development
DATABASE_URL=postgresql+asyncpg://registers_app:dev_password@localhost:5432/registers

# Anthropic — só necessário a partir da Fase 3
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Autenticação (dev-only; NÃO usar em produção)
JWT_SECRET=dev-only-secret-do-not-use-in-prod
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Admin bootstrap (implementado a partir da Fase 1)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=adminadmin

# MinIO local (exposto em 9000)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=registers-media
S3_ACCESS_KEY=minio_dev
S3_SECRET_KEY=minio_dev_secret
S3_FORCE_PATH_STYLE=true

# CORS + logs
ALLOWED_ORIGINS=http://localhost:3000
TZ=America/Sao_Paulo
LOG_LEVEL=DEBUG
LOG_FORMAT=text
